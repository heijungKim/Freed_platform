{
  "name": "freed-platform-erp",
  "version": "1.0.0",
  "private": true,
  "description": "Freed Platform ERP - 법인 / PG / 거래내역 / 선불카드 / 집계 / 사용자 관리",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:server": "node --watch --disable-warning=ExperimentalWarning server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/seed-cli.js --reset",
    "test": "node --disable-warning=ExperimentalWarning --test server/test/*.test.js",
    "build:pages": "vite build --mode demo",
    "preview:pages": "vite preview --mode demo --outDir ../dist-pages"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "sql.js": "^1.12.0",
    "vite": "^6.0.7"
  }
}
